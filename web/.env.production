# Production build values. Loaded automatically by `vite build`, so a deploy
# does not depend on environment variables being set correctly by hand in a
# dashboard somewhere.

# The pipeline's public origin: an Oracle VM, with Caddy in front for TLS.
# Baked into the bundle at build time. Unset, the frontend uses relative
# paths, which work in development through Vite's proxy and resolve against
# the static host in production, returning 404s.
VITE_API_BASE=https://api.findmyspot.tech

# Mock mode defaults to ON when unset. Production must say otherwise, or the
# deployed site replays contracts/mock_sequence.json and never contacts the
# pipeline at all, which looks exactly like a working demo and is not one.
VITE_USE_MOCK=0
