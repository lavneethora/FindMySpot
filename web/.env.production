# Production build values. Loaded automatically by `vite build`, so a deploy
# does not depend on environment variables being set correctly by hand in a
# dashboard somewhere.

# The pipeline's public origin. Render serves it with TLS directly, so there
# is no api.findmyspot.tech and no Caddy in the path. Baked into the bundle at build time: unset, the
# frontend uses relative paths, which work in development through Vite's proxy
# and resolve against the static host in production, returning 404s.
VITE_API_BASE=https://findmyspot-pipeline.onrender.com

# Mock mode defaults to ON when unset. Production must say otherwise, or the
# deployed site replays contracts/mock_sequence.json and never contacts the
# pipeline at all, which looks exactly like a working demo and is not one.
VITE_USE_MOCK=0
