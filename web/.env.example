# Copy to web/.env.local and edit if you need to.

# 1 replays contracts/mock_sequence.json in process. No Python, no dataset, no network.
# This is the default when the variable is unset, and the frontend must keep working
# this way at all times.
VITE_USE_MOCK=1

# Where the Python pipeline serves /api, /video and /ws. Only read by vite.config.ts,
# and only used by the dev server proxy. The same value is the default in vite.config.ts,
# so this only needs editing if the pipeline moves again.
VITE_PIPELINE_ORIGIN=http://localhost:8100
